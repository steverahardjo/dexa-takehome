# Copy to .env and adjust. `docker compose up -d --build` runs MySQL, RustFS
# (S3-compatible object storage), and the four services (auth, employee,
# attendance, storage) behind the gateway.

# Database
MYSQL_ROOT_PASSWORD=secure_root_password
DB_DATABASE=absences
DB_USERNAME=attendance
DB_PASSWORD=attend1234
DB_PORT=3306

# The gateway is the only published backend port. Everything else is TCP on the
# compose network.
GATEWAY_PORT=3003

# Signing secret and OTP hashing. Auth signs tokens, the gateway verifies them.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
OTP_HASH_SECRET=change-me-to-another-long-random-string
OTP_EXPIRY_SECONDS=300

# Attendance rules
COMPANY_TIMEZONE=Asia/Jakarta
REQUIRED_CHECK_IN=09:00
ATTENDANCE_ABSENT_CRON=0 15 * * *

# Object storage (RustFS): avatars and check-in proofs.
#
# RustFS reads root credentials from its environment, so the storage service
# and the server share this pair; there is no admin API or layout to provision.
# The values below are dev defaults that already match docker-compose.yml, so
# the stack boots without editing this file. Rotate them before exposing the
# stack: anyone holding them can read every object.
RUSTFS_ACCESS_KEY=absencesrustfs
RUSTFS_SECRET_KEY=7689b2602111aaae666f8f9fb7168418133ae9f295426cefe3e6336fda23b62a
RUSTFS_BUCKET=absences
# Presigned URLs are signed over their host, and the browser uploads straight to
# the S3 port: these must name an address the browser resolves. Point them at
# the public host/port in production (or the signature will not match).
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

# Everything date-related uses this zone: containers, MySQL and the seed
TZ=Asia/Jakarta

# Frontend origin allowed by CORS (comma separated), and where the browser's
# /api/* calls are rewritten to. The same origin is allowed by RustFS, because
# the browser PUTs uploads straight to storage.
FRONTEND_ORIGIN=http://localhost:3000
GATEWAY_URL=http://localhost:3003
# Swagger UI / raw documents served by the gateway (/docs, /docs-json).
OPENAPI_ENABLED=true

# Mail. The only provider today is "log", which prints the code and refuses to
# run with NODE_ENV=production: wire a real provider before deploying.
EMAIL_PROVIDER=log
MAIL_FROM="Absence Management <absences@example.com>"
