# Copy to .env and adjust. `docker compose up -d --build` runs MySQL plus the
# auth, employee and admin containers.

# Database
DB_ROOT_PASSWORD=secure_root_password
DB_DATABASE=absences
DB_USERNAME=attendance
DB_PASSWORD=attend1234
DB_PORT=3306

# Host ports the three services are published on
AUTH_PORT=3001
EMPLOYEE_PORT=3002
ADMIN_PORT=3003

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=28800
# Return the OTP in the API response outside production so the demo needs no mail
OTP_DEV_RETURN=true
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Attendance / capture
CAPTURE_TTL_SECONDS=600
SEED_DEMO=true

# Everything date-related uses this zone: containers, MySQL and the seed
TZ=Asia/Jakarta

# Frontend origin allowed by CORS (comma separated)
FRONTEND_ORIGIN=http://localhost:3000

# Mail. The sign-in code goes through Brevo when BREVO_API_KEY is set, else
# SMTP when SMTP_HOST is, else it is only logged. MAIL_FROM is the sender for
# both real channels - in Brevo it must be a verified sender address.
MAIL_FROM="Absence Management <absences@sjrah.net>"
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
