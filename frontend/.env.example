# Single NestJS API (backend/). The browser calls /api/* on this origin and
# next.config.ts rewrites it to this URL.
API_URL=http://127.0.0.1:3000

# Prefilled on the sign-in form; the backend seed creates this master admin.
NEXT_PUBLIC_DEMO_EMAIL=master@absences.local

# Business timezone used to decide "today" and render timestamps.
NEXT_PUBLIC_COMPANY_TIMEZONE=Asia/Jakarta
