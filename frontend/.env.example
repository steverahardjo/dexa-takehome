# Where the three backend containers listen. `next.config.ts` rewrites
# /api/auth, /api/admin, /api/employee and /api/attendance to these.
AUTH_SERVICE_URL=http://localhost:3001
EMPLOYEE_SERVICE_URL=http://localhost:3002
ADMIN_SERVICE_URL=http://localhost:3003

# Prefilled on the sign-in form; the database seeds this HR Admin account.
NEXT_PUBLIC_DEMO_EMAIL=john@company.com
