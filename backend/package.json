{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build backend && nest build auth && nest build employee && nest build attendance && nest build storage",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"shared/**/*.ts\"",
    "start": "nest start backend",
    "start:dev": "nest start backend --watch",
    "start:debug": "nest start backend --debug --watch",
    "start:prod": "node dist/apps/backend/main",
    "start:gateway": "nest start backend",
    "start:gateway:dev": "nest start backend --watch",
    "start:auth": "nest start auth",
    "start:auth:dev": "nest start auth --watch",
    "start:employee": "nest start employee",
    "start:employee:dev": "nest start employee --watch",
    "start:attendance": "nest start attendance",
    "start:attendance:dev": "nest start attendance --watch",
    "start:storage": "nest start storage",
    "start:storage:dev": "nest start storage --watch",
    "lint": "oxlint --type-aware apps/ shared/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "seed:build": "tsc -p scripts/tsconfig.seed.json",
    "seed": "npm run seed:build && node dist/seed/scripts/seed.js",
    "seed:docker": "docker compose -f ../docker-compose.yml run --rm seed",
    "email:smoke:build": "tsc -p scripts/tsconfig.email-smoke.json",
    "email:smoke": "npm run email:smoke:build && node dist/email-smoke/scripts/email-smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.3.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "minio": "^8.0.7",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
