# Copy to `.env` (or keep real values in the environment). The API reads
# `.env`, then falls back to the repo-root `.env` for local convenience.

NODE_ENV=development
PORT=3000
# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Public base URL used when building attendance photo links
PUBLIC_API_URL=http://localhost:3000

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=absences
DB_PASSWORD=absences
DB_DATABASE=absences
DB_SSL=false
DB_LOGGING=false
# Schema is migration-driven. Never enable in production.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# --- JWT / sessions ---------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- OTP (passwordless login) ----------------------------------------------
OTP_SECRET=replace-with-another-long-random-string
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS=5
OTP_REQUEST_WINDOW_SECONDS=900
# Returns the code in the API response outside production; local testing only.
OTP_DEV_RETURN=false

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Absences <onboarding@resend.dev>"

# --- Storage ----------------------------------------------------------------
# "memory" (development/test) or "s3"
STORAGE_PROVIDER=memory
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=true

# --- Company defaults (used when no employee/division schedule applies) -----
COMPANY_TIMEZONE=Asia/Jakarta
COMPANY_CHECK_IN=09:00:00
COMPANY_CHECK_OUT=18:00:00
COMPANY_WORKING_DAYS=1,2,3,4,5

# --- Bootstrap / seed -------------------------------------------------------
# The MASTER_ADMIN identity is only created by the seed, never by registration.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_NAME="Master Admin"
SEED_DEMO=true
