# Copy to .env for `npm run start:dev` (all domains in one process).

NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absences
DB_USERNAME=attendance
DB_PASSWORD=attend1234
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_SECRET=development-only-secret
ACCESS_TOKEN_TTL_SECONDS=28800

OTP_DEV_RETURN=true
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

CAPTURE_TTL_SECONDS=600
SEED_DEMO=true

TZ=Asia/Jakarta
FRONTEND_ORIGIN=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
