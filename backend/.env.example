# Database (MySQL 8.4; one server and one schema for every service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absences
DB_USERNAME=attendance
DB_PASSWORD=attend1234
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Gateway (the only public HTTP process)
GATEWAY_HTTP_PORT=3003
FRONTEND_ORIGIN=http://localhost:3000
# Swagger UI on /docs and the raw documents on /docs-json and /docs-yaml.
# Set to false to stop serving them (e.g. on a public deployment).
OPENAPI_ENABLED=true
# Must match the auth service: the gateway verifies, auth signs.
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECONDS=900

# Auth service (internal TCP)
AUTH_TCP_HOST=127.0.0.1
AUTH_TCP_PORT=4002
OTP_HASH_SECRET=change-me-in-production
OTP_EXPIRY_SECONDS=300
# "log" prints the code, "resend" sends it through the Resend API.
EMAIL_PROVIDER=log
# Required when EMAIL_PROVIDER=resend. The sender must be on a verified domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Absence Management <no-reply@example.com>"

# Employee service (internal TCP)
EMPLOYEE_TCP_HOST=127.0.0.1
EMPLOYEE_TCP_PORT=4003

# Attendance service (internal TCP)
ATTENDANCE_TCP_HOST=127.0.0.1
ATTENDANCE_TCP_PORT=4004
COMPANY_TIMEZONE=Asia/Jakarta
REQUIRED_CHECK_IN=09:00
ATTENDANCE_ABSENT_CRON=0 15 * * *
HOLIDAY_API_URL=https://api.kemendesa.link/libur-nasional/api/holidays/latest
HOLIDAY_CACHE_TTL_SECONDS=21600

# Storage service (internal TCP)
STORAGE_TCP_HOST=127.0.0.1
STORAGE_TCP_PORT=4001

# RustFS (S3 compatible). One private bucket, `avatars/` and `proofs/` inside.
# RustFS defaults to us-east-1 and rejects a mismatch in the SigV4 scope, so
# keep MINIO_REGION equal to RUSTFS_REGION on the server.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=absencesrustfs
MINIO_SECRET_KEY=7689b2602111aaae666f8f9fb7168418133ae9f295426cefe3e6336fda23b62a
MINIO_REGION=us-east-1
MINIO_BUCKET=absences
# Presigned URLs are signed for the host the browser connects to. Leave these
# unset when that is the same endpoint the backend uses (as in local dev).
# MINIO_PUBLIC_ENDPOINT=localhost
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=false
MINIO_UPLOAD_URL_TTL=900
MINIO_DOWNLOAD_URL_TTL=900
MINIO_MAX_UPLOAD_BYTES=10485760
