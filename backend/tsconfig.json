{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  },
  "files": [],
  "references": [
    {
      "path": "./apps/backend/tsconfig.app.json"
    },
    {
      "path": "./apps/auth/tsconfig.app.json"
    },
    {
      "path": "./apps/employee/tsconfig.app.json"
    },
    {
      "path": "./apps/storage/tsconfig.app.json"
    },
    {
      "path": "./apps/attendance/tsconfig.app.json"
    }
  ]
}
